# ========================================================
# KEV Backend - Configuración de Inferencia
# ========================================================

# --------------------------------------------------------
# 1. SELECCIÓN DE MODELO
# --------------------------------------------------------
# Opción A: KEV-0.8B (Recomendado y activo por defecto)
# - Consumo: ~1.8 GB RAM.
# - Ideal para: CPU y equipos con 8 GB a 16 GB de RAM.
# - Velocidad: Muy rápida en CPU (pocos cientos de ms).
KEV_MODEL=jaredpalmer/kev-0.8b

# Opción B: KEV-4B (Descomenta para usar)
# - Consumo: ~8 a 9 GB RAM.
# - Precisión: 83.7% (frente a 85.7% de JEV).
# - Recomendado para: Equipos con 32 GB RAM (CPU) o GPU con 8-12 GB VRAM.
# KEV_MODEL=jaredpalmer/kev-4b

# Opción C: KEV-9B (Descomenta para usar)
# - Consumo: ~18 a 20 GB RAM.
# - Precisión: 85.2% (Máxima fidelidad a JEV, 85.7%).
# - Recomendado para: GPU dedicada con 16-24 GB VRAM o servidores cloud.
# KEV_MODEL=jaredpalmer/kev-9b

# Opción D: KEV-4B Generación Qwen3 (Versión anterior más rápida en Mac/CPU)
# KEV_MODEL=jaredpalmer/kev-4b@qwen3


# --------------------------------------------------------
# 2. FIDELIDAD Y PRECISIÓN
# --------------------------------------------------------
# Aritmética de fechas determinista:
# Calcula automáticamente diferencias en días entre fechas absolutas (sube precisión de 80% a 90%).
KEV_DATE_FACTS=1

# Precisión numérica:
# - fp32: Recomendado en CPU (precisión exacta de 32 bits sin redondeo).
# - bf16: Recomendado si usas GPU CUDA (bfloat16 más rápido y menor consumo de VRAM).
KEV_DTYPE=fp32


# --------------------------------------------------------
# 3. RED Y PUERTO
# --------------------------------------------------------
# IP de escucha dentro del contenedor (0.0.0.0 permite conexiones desde el host exterior)
KEV_HOST=0.0.0.0

# Puerto del servicio
PORT=9936


# --------------------------------------------------------
# 4. SEGURIDAD Y AUTENTICACIÓN (OPCIONAL)
# --------------------------------------------------------
# Dejar vacío para acceso local abierto sin autenticación.
# Si defines una clave, los clientes deben enviar:
# Header -> Authorization: Bearer <tu_clave>
KEV_API_KEY=
